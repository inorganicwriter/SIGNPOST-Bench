# SIGNPOST-Bench Environment Configuration
# Copy this file to .env and fill in your values
# WARNING: Never commit .env to git

# Sponsor API Gateway (required for evaluation)
SPONSOR_API_BASE=http://your-gateway-url/v1
SPONSOR_API_KEY=sk-xxx

# Google Gemini API (optional, for attack generation)
# GEMINI_API_KEY=AIza...

# Optional provider keys
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_API_KEY=sk-...
# SILICONFLOW_API_KEY=sk-...
# RELAY_API_KEY=...
